<Window x:Class="BabbleFrameBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BabbleFrameBridge.App"
 Title="Face Tracking Bridge" Width="1200" Height="900" MinWidth="1020" MinHeight="760" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Background="{DynamicResource Cream}" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource BrandFont}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Icon="Assets/Brand/bridge-logo.png">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBackground}">
   <Grid Margin="18,26,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal" Margin="6,0,0,24"><Image Source="Assets/Brand/bridge-logo.png" Width="34" Height="34" Margin="0,0,10,0"/><TextBlock x:Name="BrandWordmark" Text="Face Tracking Bridge" Width="126" LineHeight="21" Foreground="{DynamicResource HeroInk}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" AutomationProperties.Name="Face Tracking Bridge"/></StackPanel>
     <Border Height="1" Background="{DynamicResource SidebarDivider}" Margin="5,0,5,23"/><TextBlock Text="TRACKING WORKSPACE" Foreground="{DynamicResource SidebarMuted}" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,14"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <RadioButton x:Name="OverviewNav" GroupName="Pages" Style="{StaticResource Navigation}" Tag="overview" Checked="Navigate_Click" IsChecked="True"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource OutlineIcon}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M3,3H10V10H3Z M14,3H21V10H14Z M3,14H10V21H3Z M14,14H21V21H14Z" Margin="0,0,12,0"/><TextBlock Text="Overview" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="ModulesNav" GroupName="Pages" Style="{StaticResource Navigation}" Tag="modules" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource OutlineIcon}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M3,7L12,2 21,7 12,12Z M3,7V17L12,22 21,17V7 M12,12V22" Margin="0,0,12,0"/><TextBlock Text="Modules" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="SettingsNav" GroupName="Pages" Style="{StaticResource Navigation}" Tag="settings" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource OutlineIcon}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M5,2V22 M12,2V22 M19,2V22 M2,8H8 M9,16H15 M16,7H22" Margin="0,0,12,0"/><TextBlock Text="Connection" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="PreferencesNav" GroupName="Pages" Style="{StaticResource Navigation}" Tag="preferences" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource OutlineIcon}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M9,3H15L16,6 19,7 21,10 19,12 21,15 19,18 16,18 15,21H9L8,18 5,18 3,15 5,12 3,10 5,7 8,6Z M16,12A4,4 0 1 1 8,12A4,4 0 1 1 16,12Z" Margin="0,0,12,0"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="ActivityNav" GroupName="Pages" Style="{StaticResource Navigation}" Tag="activity" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource OutlineIcon}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M2,12H6L9,4 14,20 17,12H22" Margin="0,0,12,0"/><TextBlock Text="Activity log" VerticalAlignment="Center"/></StackPanel></RadioButton>
    </StackPanel>
    <StackPanel Grid.Row="3">

     <Button Content="Setup guide  ↗" Style="{StaticResource LinkButton}" Foreground="{DynamicResource SidebarInk}" HorizontalAlignment="Left" Margin="8,0,0,18" Click="Guide_Click"/>
     <Button Style="{StaticResource LinkButton}" Foreground="{DynamicResource SidebarMuted}" HorizontalAlignment="Left" Margin="8,0,0,7" Click="Attribution_Click"><TextBlock Text="Credits &amp; licenses ↗" FontSize="10"/></Button>
     <TextBlock x:Name="BuildLabel" Text="INDEPENDENT BUILD" Foreground="{DynamicResource SidebarFaint}" FontSize="9" Margin="8,0,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
   <Ellipse Width="900" Height="650" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-340,-250,0"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AmbientPrimaryStart}" Offset="0"/><GradientStop Color="{DynamicResource AmbientPrimaryEnd}" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
   <Ellipse Width="800" Height="600" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-300,0,0,-270"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AmbientSecondaryStart}" Offset="0"/><GradientStop Color="{DynamicResource AmbientSecondaryEnd}" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
   <Viewbox Stretch="Fill" VerticalAlignment="Bottom" Height="200" Opacity="0.09"><Canvas Width="1000" Height="200"><Path Stroke="{DynamicResource Accent}" StrokeThickness="1" Data="M-30,95C180,190 300,-20 550,90S850,195 1030,100 M-30,112C180,207 300,-3 550,107S850,212 1030,117 M-30,129C180,224 300,14 550,124S850,229 1030,134"/></Canvas></Viewbox>
  </Grid>
  <Grid Grid.Column="1" Margin="32,25,32,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="Face Tracking Bridge" Style="{StaticResource PageHeading}"/><TextBlock x:Name="PageSubtitle" Text="Your expressions, connected." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,3,0,0"/></StackPanel>
    <Border Grid.Column="1" CornerRadius="16" Background="{DynamicResource SoftBackground}" Padding="12,7" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,7,0"/><TextBlock x:Name="ProviderTag" MaxWidth="240" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="MODULES" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold" FontSize="10"/></StackPanel></Border>
   </Grid>
   <Border x:Name="GlobalNotice" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1" CornerRadius="12" Padding="14,9" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="GlobalNoticeText" FontSize="12" Foreground="{DynamicResource ErrorInk}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="GlobalNoticeDismiss" Grid.Column="1" Content="×" Style="{StaticResource LinkButton}" Foreground="{Binding Foreground,ElementName=GlobalNoticeText}" FontSize="20" Padding="6,0" Margin="10,0,0,0" ToolTip="Dismiss notification" AutomationProperties.Name="Dismiss notification" Click="DismissNotice_Click"/></Grid></Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
    <Grid>
     <StackPanel x:Name="OverviewPage">
      <Border CornerRadius="18" Padding="0" Margin="0,0,0,18" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" ClipToBounds="True">
       <Border.Background><DynamicResource ResourceKey="HeroBackground"/></Border.Background>
       <Grid x:Name="HeroSurface" SizeChanged="Hero_SizeChanged">
        <local:ParticleField x:Name="HeroParticles" IsHitTestVisible="False"/>
        <Border IsHitTestVisible="False"><Border.Background><RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.4" RadiusY="0.4"><GradientStop Color="{DynamicResource HeroGlowStart}" Offset="0"/><GradientStop Color="{DynamicResource HeroGlowEnd}" Offset="0.7"/></RadialGradientBrush></Border.Background></Border>
        <Border IsHitTestVisible="False"><Border.Background><RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.7" RadiusY="0.9"><GradientStop Color="#00000000" Offset="0.25"/><GradientStop Color="#4D000000" Offset="1"/></RadialGradientBrush></Border.Background></Border>
       <Grid MinHeight="163" Margin="27,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
        <StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{DynamicResource Focus}" Margin="0,0,8,0"/><TextBlock Text="TRACKING CONNECTION" Foreground="{DynamicResource HeroMuted}" FontWeight="SemiBold" FontSize="10"/></StackPanel>
         <TextBlock x:Name="StateTitle" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Getting ready" Foreground="{DynamicResource HeroInk}" FontSize="27" FontWeight="Bold" Margin="0,10,0,7"/>
         <TextBlock x:Name="StateDetail" Text="Checking your module…" Foreground="{DynamicResource HeroMuted}" FontSize="12" Margin="0,0,12,18" MinHeight="19"/>
         <Button x:Name="StartButton" Content="Start bridge" Background="{DynamicResource HeroButtonBackground}" Foreground="{DynamicResource HeroButtonInk}" Padding="20,11" MinWidth="126" HorizontalAlignment="Left" Click="Start_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><Image Source="{StaticResource BridgeLogoWhite}" Width="112" Height="100" HorizontalAlignment="Center"/><TextBlock x:Name="HeadsetState" Text="Headset · waiting" Foreground="{DynamicResource HeroMuted}" FontSize="10" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel>
       </Grid></Grid>
      </Border>
      <Grid Margin="0,0,0,18">
       <Border Style="{StaticResource Card}"><StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><Border Background="{DynamicResource SoftBackground}" CornerRadius="8" Padding="8" Margin="0,0,10,0"><Path Style="{StaticResource OutlineIcon}" Data="M3,12H7L10,5 14,19 17,12H21"/></Border><TextBlock Text="VRChat output" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="OutputRate" Text="0 msgs/s" FontSize="29" FontWeight="Bold"/><TextBlock Text="OSC messages sent" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,2,0,0"/><TextBlock x:Name="SenderCadence" Text="Bridge idle" Foreground="{DynamicResource AccentInk}" FontSize="10" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="DESTINATION" Style="{StaticResource Caption}" FontSize="9"/><TextBlock x:Name="TargetLabel" Text="127.0.0.1 : 9000" FontSize="12" FontWeight="Medium"/></StackPanel></Grid>
        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,17,0,0" Padding="0,12,0,0"><StackPanel><TextBlock x:Name="AvatarLabel" Text="Avatar · waiting for VRChat" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="TrackingRoute" Text="Waiting for avatar tracking support" Foreground="{DynamicResource AccentInk}" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
       </StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0"><TextBlock Text="YOUR TRACKING MODULE" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="ModuleLabel" Text="No module installed" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="PackageDetail" Text="Add your own module ZIP to begin." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/><TextBlock x:Name="HashLabel" Foreground="{DynamicResource FaintInk}" FontFamily="Consolas" FontSize="9" Margin="0,7,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="ImportButton" Content="Add a module →" Click="ShowModules_Click"/><Button x:Name="RollbackButton" Style="{StaticResource LinkButton}" Content="Restore previous" Margin="0,12,0,0" FontSize="11" Click="Rollback_Click" IsEnabled="False"/></StackPanel>
       </Grid>
      </Border>
      <Border Background="{DynamicResource SoftBackground}" CornerRadius="12" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="LatestActivity" Grid.Column="1" Text="Everything is ready for your next session." FontSize="11" Foreground="{DynamicResource SubtleInk}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Grid.Column="2" Content="View activity  →" Style="{StaticResource LinkButton}" FontSize="10" Click="ShowActivity_Click"/></Grid></Border>
     </StackPanel>
     <StackPanel x:Name="ModulesPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Padding="26"><StackPanel>
       <TextBlock Text="Your module library." FontSize="26" FontWeight="Bold"/>
       <TextBlock Text="One active module. Switch whenever your headset does." Foreground="{DynamicResource Muted}" Margin="0,8,0,23"/>
       <ItemsControl x:Name="ModuleLibrary">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="{DynamicResource InsetBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
           <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button MinWidth="110" Content="{Binding Action}" Tag="{Binding Release}" IsEnabled="{Binding CanSelect}" Style="{StaticResource QuietButton}" Click="SelectModule_Click" AutomationProperties.Name="{Binding Name}"/>
            <Button Width="40" Height="40" Padding="10" Margin="10,0,0,0" Style="{StaticResource DangerButton}" Tag="{Binding Release}" IsEnabled="{Binding CanRemove}" Click="RemoveModule_Click" ToolTip="Remove module" AutomationProperties.Name="Remove module" AutomationProperties.HelpText="{Binding Name}">
             <Path Style="{StaticResource OutlineIcon}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Data="M4,6H20 M9,6V3H15V6 M6,6L7,21H17L18,6 M10,10V17 M14,10V17"/>
            </Button>
           </StackPanel>
           <Button Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding UpdateVisibility}" Content="Update for Expressions Alpha" Tag="{Binding Release}" IsEnabled="{Binding CanUpdate}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="15,10" Click="UpdateBaballonia_Click" AutomationProperties.Name="Update for Expressions Alpha" AutomationProperties.HelpText="Download or select a compatible Baballonia module, then switch safely. Your previous module is kept."/>
           <Border Grid.Row="2" Grid.ColumnSpan="2" Visibility="{Binding ConfirmationVisibility}" Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0" Loaded="RemoveConfirmation_Loaded">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <StackPanel VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="{Binding RemovalMessage}" Foreground="{DynamicResource ErrorInk}" FontSize="12" FontWeight="Medium"/><TextBlock Text="Your original files and other modules are kept." Foreground="{DynamicResource ErrorInk}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Cancel" Tag="{Binding Release}" IsEnabled="{Binding CanRemove}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="CancelRemoveModule_Click" AutomationProperties.Name="Cancel removal"/><Button Content="Remove" Tag="{Binding Release}" IsEnabled="{Binding CanRemove}" Style="{StaticResource DangerButton}" Click="ConfirmRemoveModule_Click" AutomationProperties.Name="Confirm remove module"/></StackPanel>
            </Grid>
           </Border>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <Border Background="{DynamicResource SoftBackground}" CornerRadius="14" Padding="24" Margin="0,12,0,0"><StackPanel>
        <TextBlock Text="Add a module." FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Download an official module here. Your active bridge keeps running until you choose Use module." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,9,0,17" TextWrapping="Wrap"/>
        <ItemsControl x:Name="DownloadChoices"><ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="{DynamicResource InsetBackground}" CornerRadius="12" Padding="15" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
          <Button Grid.Column="1" Content="Official link ↗" Tag="{Binding OfficialUrl}" Style="{StaticResource LinkButton}" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center" Click="ModuleSource_Click" AutomationProperties.Name="Official module source" AutomationProperties.HelpText="{Binding Name}"/>
          <Button Grid.Column="2" Content="Download ↓" Tag="{Binding Kind}" IsEnabled="{Binding CanDownload}" Style="{StaticResource QuietButton}" Padding="15,10" VerticalAlignment="Center" Click="DownloadModule_Click" AutomationProperties.Name="{Binding DownloadLabel}" ToolTip="Download the module ZIP and add it to your library"/>
         </Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock x:Name="DownloadChoicesEmptyText" Visibility="Collapsed" Text="All built-in modules are already in your library. You can still import another module below." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,14"/>
        <Border x:Name="DownloadProgressPanel" Visibility="Collapsed" Padding="2,8,2,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock x:Name="DownloadStatus" FontSize="12" Margin="0,0,0,9"/><ProgressBar x:Name="DownloadProgressBar" Maximum="1" Height="5"/></StackPanel><Button x:Name="DownloadCancelButton" Grid.Column="1" Content="Cancel" Style="{StaticResource LinkButton}" Click="CancelDownload_Click" AutomationProperties.Name="Cancel module download"/></Grid></Border>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,17"><Button Content="Headset runtime setup ↗" Style="{StaticResource LinkButton}" FontSize="11" Click="RuntimeSetup_Click"/><TextBlock Text="Runs separately on the headset." Foreground="{DynamicResource Muted}" FontSize="11" Margin="13,0,0,0" VerticalAlignment="Center"/></StackPanel>
        <Button Content="Import DLL or ZIP ↑" IsEnabled="{Binding IsEnabled,ElementName=ImportButton}" Click="Import_Click" HorizontalAlignment="Left"/>
        <TextBlock Text="Other VRCFaceTracking SDK modules are welcome. Import a DLL, or a ZIP with its supporting files. A module.json file is optional." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,0"/>
        <TextBlock Text="Modules run code on your computer under their authors’ licenses. Only import modules you trust." Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,13,0,0"/>
       </StackPanel></Border>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Padding="28"><StackPanel>
       <TextBlock Text="Your connection to VRChat." FontSize="23" FontWeight="Bold"/>
       <TextBlock Text="The defaults work for VRChat on this computer. Change them if your setup needs a different destination." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,28"/>
       <TextBlock Text="VRChat IP address" Style="{StaticResource Caption}"/><TextBox x:Name="HostBox" AutomationProperties.Name="VRChat IP address" Width="450" HorizontalAlignment="Left" Margin="0,0,0,22"/>
       <Grid MaxWidth="460" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="20"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VRChat send port" Style="{StaticResource Caption}"/><TextBox x:Name="PortBox" AutomationProperties.Name="VRChat send port"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="VRChat feedback port" Style="{StaticResource Caption}"/><TextBox x:Name="ReceiveBox" AutomationProperties.Name="VRChat feedback port"/></StackPanel></Grid>
       <Button x:Name="SaveButton" Content="Save connection" Click="Save_Click" HorizontalAlignment="Left" Margin="0,26,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="PreferencesPage" Visibility="Collapsed">
      <Border x:Name="StartupWindowCard" Style="{StaticResource Card}" Padding="28"><StackPanel>
       <TextBlock Text="Startup &amp; system tray." FontSize="23" FontWeight="Bold"/>
       <TextBlock Text="Choose how the app opens and follows your VR session." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,23"/>
       <CheckBox x:Name="AutoStartBox" Foreground="{DynamicResource AccentInk}" Content="Start the bridge when this app opens" FontSize="13" Margin="0,0,0,19" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
       <CheckBox x:Name="StartWithSteamVrBox" Foreground="{DynamicResource AccentInk}" Content="Start with SteamVR" FontSize="13" Margin="0,0,0,19" Checked="SteamVrAutoStart_Changed" Unchecked="SteamVrAutoStart_Changed" AutomationProperties.Name="Start with SteamVR"/>
       <CheckBox x:Name="CloseWithSteamVrBox" Foreground="{DynamicResource AccentInk}" Content="Close when SteamVR exits" FontSize="13" Margin="0,0,0,19" Checked="StartupWindowSetting_Changed" Unchecked="StartupWindowSetting_Changed" AutomationProperties.Name="Close when SteamVR exits"/>
       <CheckBox x:Name="StartMinimizedBox" Foreground="{DynamicResource AccentInk}" Content="Start minimized to system tray" FontSize="13" Margin="0,0,0,16" Checked="StartupWindowSetting_Changed" Unchecked="StartupWindowSetting_Changed" AutomationProperties.Name="Start minimized to system tray" AutomationProperties.HelpText="Open in the system tray on the next launch, including launches from SteamVR."/>
       <TextBlock Text="Closing the window with X keeps tracking running in the system tray. Double-click the tray icon to reopen, or right-click it for Open and Quit. Start minimized applies on the next launch." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
       <Button Content="Quit app" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,24,0,0" Click="Quit_Click" AutomationProperties.Name="Quit Face Tracking Bridge"/>
      </StackPanel></Border>
     </StackPanel>
     <Grid x:Name="ActivityPage" Visibility="Collapsed"><Border Style="{StaticResource Card}" Padding="24"><StackPanel><Grid Margin="0,0,0,18"><TextBlock Text="What’s happening behind the scenes." FontSize="20" FontWeight="Bold"/><Button Content="Open log folder  ↗" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,40,0,0" Click="Logs_Click"/></Grid><TextBox x:Name="LogBox" MinHeight="400" MaxHeight="520" Height="450" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="{DynamicResource LogBackground}" Padding="14" AutomationProperties.Name="Activity log"/></StackPanel></Border></Grid>
    </Grid>
   </ScrollViewer>
   <Grid Grid.Row="3" Margin="0,17,0,0"><TextBlock Text="Independent project. Built on VRCFaceTracking." Foreground="{DynamicResource FaintInk}" FontSize="10"/><Button Content="GitHub  ↗" Style="{StaticResource LinkButton}" FontSize="10" HorizontalAlignment="Right" Click="Website_Click"/></Grid>
  </Grid>
 </Grid>
</Window>

